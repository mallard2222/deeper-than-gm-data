8/boise-state-broncos"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/68/boise-state-broncos"}}}}},{"id":68,"type":"team","guid":"519fd9ff-73b0-314f-b6e6-c0bcbc29b028","description":"Boise State University","sportId":3170,"teamId":68,"team":{"id":68,"description":"Boise State University","abbreviation":"Boise State","shortDisplayName":"Boise State"}},{"id":550673,"type":"athlete","uid":"s:20~l:23~a:4870513","guid":"14059f7d-d328-38ad-8606-e59713821aee","description":"Maddux Madsen","sportId":23,"athleteId":4870513,"athlete":{"id":4870513,"description":"Maddux Madsen","links":{"mobile":{"athletes":{"href":"https://www.espn.com/college-football/player/_/id/4870513/maddux-madsen"}},"web":{"athletes":{"href":"https://www.espn.com/college-football/player/_/id/4870513/maddux-madsen"}}}}},{"id":615136,"type":"athlete","uid":"s:20~l:23~a:5160730","guid":"0dc35082-285c-3e8a-bd70-cadcf24bbccb","description":"Max Cutforth","sportId":23,"athleteId":5160730,"athlete":{"id":5160730,"description":"Max Cutforth","links":{"mobile":{"athletes":{"href":"https://www.espn.com/college-football/player/_/id/5160730/max-cutforth"}},"web":{"athletes":{"href":"https://www.espn.com/college-football/player/_/id/5160730/max-cutforth"}}}}},{"id":409224,"type":"topic","guid":"52313677-19f8-b106-ec91-d8d17e6087fe","description":"news","sportId":0,"topicId":781}],"keywords":["NCAA Football","Boise State Broncos","Boise State University","Maddux Madsen","Max Cutforth","news"],"story":"<p><a href=\"https://www.espn.com/college-football/team/_/id/68/boise-state-broncos\">Boise State</a> quarterback <a data-player-guid=\"14059f7d-d328-38ad-8606-e59713821aee\" href=\"http://www.espn.com/college-football/player/_/id/4870513/maddux-madsen\">Maddux Madsen</a> will not play at <a href=\"https://www.espn.com/college-football/team/_/id/36/colorado-state-rams\">Colorado State</a> on Saturday as he deals with a minor knee injury, sources told ESPN's Pete Thamel.</p>\n<p>Boise State expects Madsen to start against <a href=\"https://www.espn.com/college-football/team/_/id/204/oregon-state-beavers\">Oregon State</a> next week, sources said.</p>\n<p>With Madsen out, <a data-player-guid=\"0dc35082-285c-3e8a-bd70-cadcf24bbccb\" href=\"http://www.espn.com/college-football/player/_/id/5160730/max-cutforth\">Max Cutforth</a> will make his fourth career start for Boise State. Cutforth came in for Madsen against <a href=\"https://www.espn.com/college-football/team/_/id/326/texas-state-bobcats\">Texas State</a> on Saturday and led a comeback win, throwing three touchdown passes as the No. 25 Broncos made up a 25-point halftime deficit.</p>\n<p><alsosee></p>\n<p>Madsen left against the Bobcats in the fourth quarter after he took a hard shot near his left knee, watching the end of the game on crutches from the sideline. He is officially listed as questionable to play against Colorado State.</p>\n<p>The Broncos (7-1, 4-0 Pac-12) were the only ranked Group of 6 team by the College Football Playoff selection committee in its first release Tuesday.</p>\n<p>One of Cutforth's three previous starts came against Colorado State last season, when he threw for 239 yards in a 49-21 win.</p>\n<p><em>Information from The Associated Press was used in this report.</em></p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50401030"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50401030"}},"mobile":{"href":"http://m.espn.go.com/ncf/story?storyId=50401030"},"web":{"href":"https://www.espn.com/college-football/story/_/id/50401030/sources-boise-state-qb-maddux-madsen-vs-colorado-state"}},"premium":false},{"id":50400964,"nowId":"1-50400964","contentKey":"50400964-1-5-1","dataSourceIdentifier":"0718fe9cc1b2d","publishedkey":"50400964","type":"HeadlineNews","feedDisplayTyp