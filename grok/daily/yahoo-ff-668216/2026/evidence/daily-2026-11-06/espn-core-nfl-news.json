burn"}},{"id":22973,"type":"team","uid":"s:20~l:23~t:344","guid":"44572c3a-e43a-0e8e-e71e-bf3c48784923","description":"Mississippi State Bulldogs","sportId":23,"teamId":344,"team":{"id":344,"description":"Mississippi State Bulldogs","abbreviation":"MSST","shortDisplayName":"Mississippi St","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/344/mississippi-state-bulldogs"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/344/mississippi-state-bulldogs"}}}}},{"id":344,"type":"team","guid":"20f064ae-ec31-3749-b0b2-c092471038f4","description":"Mississippi State University","sportId":3170,"teamId":344,"team":{"id":344,"description":"Mississippi State University","abbreviation":"Mississippi State","shortDisplayName":"Mississippi State"}},{"id":1076,"type":"team","uid":"s:20~l:23~t:245","guid":"014788cd-231c-e33e-32c3-7e8d9a1e530f","description":"Texas A&M Aggies","sportId":23,"teamId":245,"team":{"id":245,"description":"Texas A&M Aggies","abbreviation":"TA&M","shortDisplayName":"Texas A&M","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/245/texas-am-aggies"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/245/texas-am-aggies"}}}}},{"id":245,"type":"team","guid":"fab49ca5-ec9f-3e99-8936-6f532466cf1a","description":"Texas A&M University","sportId":3170,"teamId":245,"team":{"id":245,"description":"Texas A&M University","abbreviation":"Texas A&M","shortDisplayName":"Texas A&M"}},{"id":1097,"type":"team","uid":"s:20~l:23~t:8","guid":"10e2d279-fb50-0b76-ba89-3dbe9d43fa2f","description":"Arkansas Razorbacks","sportId":23,"teamId":8,"team":{"id":8,"description":"Arkansas Razorbacks","abbreviation":"ARK","shortDisplayName":"Arkansas","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/8/arkansas-razorbacks"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/8/arkansas-razorbacks"}}}}},{"id":8,"type":"team","guid":"54db9ad2-a897-3768-ae50-f0390c0b5f03","description":"University of Arkansas","sportId":3170,"teamId":8,"team":{"id":8,"description":"University of Arkansas","abbreviation":"Arkansas","shortDisplayName":"Arkansas"}},{"id":1093,"type":"team","uid":"s:20~l:23~t:238","guid":"f2c5bf52-4c7d-78ea-ce4d-6a91faee67c8","description":"Vanderbilt Commodores","sportId":23,"teamId":238,"team":{"id":238,"description":"Vanderbilt Commodores","abbreviation":"VAN","shortDisplayName":"Vanderbilt","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/238/vanderbilt-commodores"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/238/vanderbilt-commodores"}}}}},{"id":238,"type":"team","guid":"16289c7a-8f0e-33d7-8027-833c67cb0482","description":"Vanderbilt University","sportId":3170,"teamId":238,"team":{"id":238,"description":"Vanderbilt University","abbreviation":"Vanderbilt","shortDisplayName":"Vanderbilt"}},{"id":9576,"type":"league","uid":"s:40~l:41","guid":"11965179-4504-3b99-983e-83ea0e36d5f3","description":"NCAA Men's Basketball","sportId":41,"leagueId":41,"league":{"id":41,"description":"NCAA Men's Basketball","abbreviation":"NCAAM","links":{"mobile":{"leagues":{"href":"https://www.espn.com/mens-college-basketball/"}},"web":{"leagues":{"href":"https://www.espn.com/mens-college-basketball/"}}}}},{"id":9578,"type":"league","uid":"s:40~l:54","guid":"45cd175c-f9f2-338b-83b9-6d7d64001733","description":"NCAA Women's Basketball","sportId":54,"leagueId":54,"league":{"id":54,"description":"NCAA Women's Basketball","abbreviation":"NCAAW","links":{"mobile":{"leagues":{"href":"https://www.espn.com/womens-college-basketball/"}},"web":{"leagues":{"href":"https://www.espn.com/womens-college-basketball/"}}}}},{"id":14486,"type":"league","guid":"d765930d-4c8c-47ed-8b85-8f1955d4a602","description":"NCAA - Other sports","sportId":0,"leagueId":3170,"league":{"id":3170,"description":"NCAA - Other sports"}},{"id":647280,"type":"contributor","guid":"37be3dad-8916-3040-bba4-167834f0afd0","description":"Pete Thamel","slug":"pete-thamel","contributor":{"id":3899,"description":"Pete Thamel","links":{"mobile":{"contributors":{"href":"https://www.espn.com/contributor/pete-thamel"}},"web":{"contributors":{"href":"https://www.espn.com/contributor/pete-thamel"}}}}}],"keywords":["NCAA Football","Georgia Bulldogs","University of Georgia","Alabama Crimson Tide","University of Alabama","Texas Longhorns","University of Texas","Ole Miss Rebels","University of Mississippi","LSU Tigers","Louisiana State University","Tennessee Volunteers","University of Tennessee","Florida Gators","University of Florida","Kentucky Wildcats","University of Kentucky","Missouri Tigers","University of Missouri","South Carolina Gamecocks","University of South Carolina","Oklahoma Sooners","University of Oklahoma","Auburn Tigers","Auburn","Mississippi State Bulldogs","Mississippi State University","Texas A&M Aggies","Texas A&M University","Arkansas Razorbacks","University of Arkansas","Vanderbilt Commodores","Vanderbilt University","NCAA Men's Basketball","NCAA Women's Basketball","NCAA - Other sports","Pete Thamel"],"story":"<p>The SEC is considering imposing a luxury tax on member schools that spend more on players than the allotted revenue-sharing cap under the House v. NCAA settlement, sources told ESPN on Friday.</p>\n<p>A working group of athletic directors, university presidents and general counsels has been considering the issue the past few weeks, and the league might vote on the issue in the near future, sources said.</p>\n<p>The SEC would like to approve the luxury tax before the early signing period for football (Dec. 2-4).</p>\n<p>Sources told ESPN that there's still much debate on the issue, but one formula being considered would gradually tax schools once they exceed the annual revenue-sharing cap, which was $21.3 million for the 2026-27 academic year. The cap will increase to about $22.2 million in 2027-28 under the terms of the House settlement.</p>\n<p>For instance, a school could be taxed 1% for $1 million it spends over the cap and 3% for $3 million. There's still work to be done on refining the formula, as sources caution that discussions over specifics are ongoing. The concept has been well received, but the details need to be pinned down.</p>\n<p>\"Some schools want it to be where the penalty is as low as possible, so it's cheap enough to where you're more motivated just to pay it directly and report it, and everybody's on the same page and people stop playing games,\" a source told ESPN.</p>\n<p>The SEC hopes a luxury tax will not only discourage schools from exceeding the revenue-sharing cap but also create more transparency so schools know exactly what their competitors are spending. Another goal is to limit or eliminate the need for third parties to \"wash\" the money, which is an expensive and inefficient necessity of the current system.</p>\n<p>\"It's a lot better if we all know what everybody's doing right now,\" a source told ESPN. \"We're living in this world where we have no idea what anybody's spending. Agents can play you all day long because there is no general database. We're starting to get some information, but there's not enough transparency to know what people are really doing.\"</p>\n<p>The SEC isn't sure what it would do with the money generated from a luxury tax, as that remains a looming issue. Some of it might have to go to plaintiffs' attorneys in the House case, and the league is also considering using it to fund the College Sports Commission, which enforces NIL, revenue sharing and roster limits. Another possibility is using the money to fund a post-graduate medical fund for college athletes.</p>\n<p>The SEC is not considering mimicking Major League Baseball's competitive balance tax, which funnels some of the taxes collected from big spenders back to teams from small markets with lower revenue.</p>\n<p>Last month, the Big Ten announced it was adopting a conference-level rule limiting its schools' involvement in third-party NIL agreements ahead of the potential congressional passage of the Protect College Sports Act.</p>\n<p>The PCSA would increase the amount of money schools can spend on direct payments to their players by $27.5 million, more than doubling the current $21.5 million spending cap.</p>\n<p>Combined with institutional NIL payments permitted by the House settlement, the Big Ten rule would restrict institutional involvement in student-athlete NIL agreements to a total of about $49 million per institution.</p>\n<p>The Big Ten said it would impose escalating financial penalties and other disciplinary measures for violations.</p>\n<p>It is now unclear whether Congress will pass the PCSA after the results of Tuesday's elections.</p>\n<p><em>ESPN's Jake Trotter contributed to this report.</em></p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Mark Schlabach and Pete Thamel","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50401639"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50401639"}},"mobile":{"href":"http://m.espn.go.com/ncf/story?storyId=50401639"},"web":{"href":"https://www.espn.com/college-football/story/_/id/50401639/sources-sec-mulls-luxury-tax-overspending-players"}},"premium":false},{"id":50400935,"nowId":"1-50400935","contentKey":"50400935-1-6-1","dataSourceIdentifier":"46ec0845a2170","publishedkey":"50400935","type":"Story","feedDisplayType":"Default","headline":"Joe Burrow makes time for art in Madrid ahead of Bengals-Falcons","description":"While in Spain, the Bengals quarterback is finding time for one of his off-field interests: art.","title":"Museums, art galleries and shopping: Joe Burrow's Madrid to-do list","linkText":"Joe Burrow's first stop on his day off in Madrid? The Prado","categorized":"2026-11-06T19:05:40Z","or