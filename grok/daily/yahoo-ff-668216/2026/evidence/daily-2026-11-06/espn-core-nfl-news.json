d":1100,"type":"team","uid":"s:20~l:23~t:333","guid":"258022c1-fed4-a0ce-c017-1f853c81d1a8","description":"Alabama Crimson Tide","sportId":23,"teamId":333,"team":{"id":333,"description":"Alabama Crimson Tide","abbreviation":"ALA","shortDisplayName":"Alabama","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/333/alabama-crimson-tide"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/333/alabama-crimson-tide"}}}}},{"id":333,"type":"team","guid":"284484f2-b714-35bc-9162-4dc652590b02","description":"University of Alabama","sportId":3170,"teamId":333,"team":{"id":333,"description":"University of Alabama","abbreviation":"Alabama","shortDisplayName":"Alabama"}},{"id":9571,"type":"league","uid":"s:20~l:23","guid":"0f8e3d42-fa27-3f60-9e8d-276e4892f50e","description":"NCAA Football","sportId":23,"leagueId":23,"league":{"id":23,"description":"NCAA Football","abbreviation":"NCAAF","links":{"mobile":{"leagues":{"href":"https://www.espn.com/college-football/"}},"web":{"leagues":{"href":"https://www.espn.com/college-football/"}}}}},{"id":1098,"type":"team","uid":"s:20~l:23~t:99","guid":"b9a22bd6-7449-92bc-0e95-a6d8da673b3e","description":"LSU Tigers","sportId":23,"teamId":99,"team":{"id":99,"description":"LSU Tigers","abbreviation":"LSU","shortDisplayName":"LSU","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/99/lsu-tigers"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/99/lsu-tigers"}}}}},{"id":99,"type":"team","guid":"bb1fe57d-d53d-3f5d-a207-281ead34f543","description":"Louisiana State University","sportId":3170,"teamId":99,"team":{"id":99,"description":"Louisiana State University","abbreviation":"LSU","shortDisplayName":"LSU"}},{"id":701640,"type":"contributor","guid":"660a6ff7-9dda-3846-9184-9e361c5369c9","description":"Alex Scarborough","slug":"alex-scarborough","contributor":{"id":2148,"description":"Alex Scarborough"}}],"keywords":["Ryan Coleman-Williams","Racin Delgatty","Terrance Green","Alabama Crimson Tide","University of Alabama","NCAA Football","LSU Tigers","Louisiana State University","Alex Scarborough"],"story":"<p>No. 5 <a data-clubhouse-guid=\"258022c1-fed4-a0ce-c017-1f853c81d1a8\" href=\"http://www.espn.com/college-football/team/_/id/333/alabama-crimson-tide\">Alabama</a> will get a trio of injured starters -- wide receiver <a data-player-guid=\"f5296bdb-6386-391d-aa5c-36f7d25e9929\" href=\"http://www.espn.com/college-football/player/_/id/5141711/ryan-coleman-williams\">Ryan Coleman-Williams</a>, center <a data-player-guid=\"5e828796-ba7a-3866-a18c-670f8a59334b\" href=\"http://www.espn.com/college-football/player/_/id/5152091/racin-delgatty\">Racin Delgatty</a> and defensive tackle <a data-player-guid=\"e351eced-8a48-3e33-ace4-138893c1b2b5\" href=\"http://www.espn.com/college-football/player/_/id/5158471/terrance-green\">Terrance Green</a> -- back in time for Saturday's high-stakes game at No. 14 <a data-clubhouse-guid=\"b9a22bd6-7449-92bc-0e95-a6d8da673b3e\" href=\"http://www.espn.com/college-football/team/_/id/99/lsu-tigers\">LSU</a>.</p>\n<p>Alabama on Friday announced through its NIL entity, Yea Alabama, that all three players have been cleared to play.</p>\n<p>Coleman-Williams, a former freshman All-American, was the team's leading receiver before a knee injury caused him to miss the last two games. He underwent arthroscopic surgery and was able to use the bye week for additional recovery time.</p>\n<p><alsosee></p>\n<p>Delgatty also missed the last two games with a lower leg injury. The former transfer was a key piece on the line as one of the most experienced players.</p>\n<p>With Delgatty out, <a data-player-guid=\"b57cb2b7-00c2-3c38-8dcf-3aea6db33a78\" href=\"http://www.espn.com/college-football/player/_/id/5195618/mal-waldrep-jr\">Mal Waldrep Jr.</a> started at center.</p>\n<p>With left guard <a data-player-guid=\"ab8dc91e-f187-384c-9606-d1202820512c\" href=\"http://www.espn.com/college-football/player/_/id/5153092/william-sanders\">William Sanders</a>' status still unclear, the ability to have Delgatty at center gives coaches the ability to shift Waldrep to guard if he's needed. Sanders was listed as questionable on the SEC availability report Thursday.</p>\n<p>Green's absence from a lingering foot injury was felt keenly the last few games on run defense as <a data-clubhouse-guid=\"4351fef8-fe69-53b1-ea57-72684b36ec35\" href=\"http://www.espn.com/college-football/team/_/id/61/georgia-bulldogs\">Georgia</a> and <a data-clubhouse-guid=\"de276cc4-dc02-159f-0c1c-67ddaf02a9ea\" href=\"http://www.espn.com/college-football/team/_/id/2633/tennessee-volunteers\">Tennessee</a>, in particular, were able to have success on the ground without Green's 6-foot-6, 313-pound frame clogging up the middle.</p>\n<p>There's been no definitive update on the injury status of cornerback <a data-player-guid=\"d316138f-637f-31aa-9121-8cef49d2f533\" href=\"http://www.espn.com/college-football/player/_/id/5079344/zabien-brown\">Zabien Brown</a>, a preseason All-America pick, or running back <a data-player-guid=\"650f7383-53a1-3017-8da6-8c556d340169\" href=\"http://www.espn.com/college-football/player/_/id/5264688/ej-crowell\">EJ Crowell</a>, who provides an explosive element in the run game as he averages 6.8 yards per carry. Both players were listed as questionable Thursday.</p>\n<p>Saturday's matchup carries key CFP implications as both SEC teams already have two losses. A third loss could potentially knock a team out of the playoff hunt.</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Alex Scarborough","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50401690"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50401690"}},"mobile":{"href":"http://m.espn.go.com/ncf/story?storyId=50401690"},"web":{"href":"https://www.espn.com/college-football/story/_/id/50401690/alabama-ryan-coleman-williams-trio-return-vs-lsu"}},"premium":false},{"id":50401639,"nowId":"1-50401639","contentKey":"50401639-1-5-1","dataSourceIdentifier":"d479b8dc6f370","publishedkey":"50401639","type":"HeadlineNews","feedDisplayType":"Default","headline":"Sources: SEC considering luxury tax for excessive spending on players","description":"The SEC is mulling a luxury tax on programs that spend more on players than the allotted revenue-sharing cap under the House v. NCAA settlement.","title":"Sources - SEC mulls luxury tax for overspending on players","linkText":"Sources: SEC considering luxury tax for excessive spending on players","categorized":"2026-11-06T21:31:57Z","originallyPosted":"2026-11-06T20:33:16Z","lastModified":"2026-11-06T21:31:57Z","published":"2026-11-06T21:31:57Z","root":"ncf","section":"College Football","images":[{"dataSourceIdentifier":"86741cab1ded5","id":49716960,"type":"header","name":"SEC [1296x729]","credit":"Imagn Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0825/r1706540_1296x729_16-9.jpg"}],"categories":[{"id":9571,"type":"league","uid":"s:20~l:23","guid":"0f8e3d42-fa27-3f60-9e8d-276e4892f50e","description":"NCAA Football","sportId":23,"leagueId":23,"league":{"id":23,"description":"NCAA Football","abbreviation":"NCAAF","links":{"mobile":{"leagues":{"href":"https://www.espn.com/college-football/"}},"web":{"leagues":{"href":"https://www.espn.com/college-football/"}}}}},{"id":1091,"type":"team","uid":"s:20~l:23~t:61","guid":"4351fef8-fe69-53b1-ea57-72684b36ec35","description":"Georgia Bulldogs","sportId":23,"teamId":61,"team":{"id":61,"description":"Georgia Bulldogs","abbreviation":"UGA","shortDisplayName":"Georgia","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/61/georgia-bulldogs"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/61/georgia-bulldogs"}}}}},{"id":61,"type":"team","guid":"429cd0