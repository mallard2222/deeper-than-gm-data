ootball/player/_/id/5075805/aidan-chiles"}}}}},{"id":1079,"type":"team","uid":"s:20~l:23~t:77","guid":"ca8359bf-52ca-f069-b9c4-bbfbcfc15c64","description":"Northwestern Wildcats","sportId":23,"teamId":77,"team":{"id":77,"description":"Northwestern Wildcats","abbreviation":"NU","shortDisplayName":"Northwestern","links":{"mobile":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/77/northwestern-wildcats"}},"web":{"teams":{"href":"https://www.espn.com/college-football/team/_/id/77/northwestern-wildcats"}}}}},{"id":77,"type":"team","guid":"7fed738d-c422-31d5-9ad6-eb656838add9","description":"Northwestern University","sportId":3170,"teamId":77,"team":{"id":77,"description":"Northwestern University","abbreviation":"Northwestern","shortDisplayName":"Northwestern"}},{"id":9571,"type":"league","uid":"s:20~l:23","guid":"0f8e3d42-fa27-3f60-9e8d-276e4892f50e","description":"NCAA Football","sportId":23,"leagueId":23,"league":{"id":23,"description":"NCAA Football","abbreviation":"NCAAF","links":{"mobile":{"leagues":{"href":"https://www.espn.com/college-football/"}},"web":{"leagues":{"href":"https://www.espn.com/college-football/"}}}}},{"id":647280,"type":"contributor","guid":"37be3dad-8916-3040-bba4-167834f0afd0","description":"Pete Thamel","slug":"pete-thamel","contributor":{"id":3899,"description":"Pete Thamel","links":{"mobile":{"contributors":{"href":"https://www.espn.com/contributor/pete-thamel"}},"web":{"contributors":{"href":"https://www.espn.com/contributor/pete-thamel"}}}}}],"keywords":["Aidan Chiles","Northwestern Wildcats","Northwestern University","NCAA Football","Pete Thamel"],"story":"<p><a data-clubhouse-guid=\"ca8359bf-52ca-f069-b9c4-bbfbcfc15c64\" href=\"http://www.espn.com/college-football/team/_/id/77/northwestern-wildcats\">Northwestern</a> starting quarterback <a data-player-guid=\"54384964-c92b-3c0b-bde6-b349e36e2fe9\" href=\"http://www.espn.com/college-football/player/_/id/5075805/aidan-chiles\">Aidan Chiles</a> is expected to miss Saturday's game against No. 19 <a data-clubhouse-guid=\"dbe71bf8-160a-45af-c855-b444d68fbe76\" href=\"http://www.espn.com/college-football/team/_/id/2294/iowa-hawkeyes\">Iowa</a>, sources told ESPN on Friday.</p>\n<p>Chiles has been dealing with an upper-body injury, and his timeline for a return is uncertain. He has thrown for 1,898 yards while accounting for 23 TDs (13 passing, 10 rushing) and just one interception this season for the Wildcats (6-2).</p>\n<p><alsosee></p>\n<p>His 80.8 QBR ranks 14th in the FBS.</p>\n<p>Veteran backup <a data-player-guid=\"17a1f8e9-6395-336a-ad90-4cbbfe689819\" href=\"http://www.espn.com/college-football/player/_/id/4685459/nicco-marchiol\">Nicco Marchiol</a>, a transfer from <a data-clubhouse-guid=\"e5ca2c6f-2389-9da3-43cd-995fad2e06c5\" href=\"http://www.espn.com/college-football/team/_/id/277/west-virginia-mountaineers\">West Virginia</a>, will make his first start for the Wildcats against the Hawkeyes. He was 6-2 as a starter with the Mountaineers and has played in 27 career games.</p>\n<p>The 6-foot-4, 225-pound Chiles has 6,014 career passing yards with 40 touchdowns and 15 interceptions. He began his college career at <a data-clubhouse-guid=\"b6d75880-f28e-7a53-ae8a-bef390847086\" href=\"http://www.espn.com/college-football/team/_/id/204/oregon-state-beavers\">Oregon State</a> and played two seasons at <a data-clubhouse-guid=\"832ac71d-f1e2-6069-3386-0251865c339e\" href=\"http://www.espn.com/college-football/team/_/id/127/michigan-state-spartans\">Michigan State</a> before transferring to Northwestern before this season.</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Pete Thamel","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50400881"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50400881"}},"mobile":{"href":"http://m.espn.go.com/ncf/story?s