8a-4473f58b8e33","description":"Cameron Bancroft","sportId":200,"athleteId":501011,"athlete":{"id":501011,"description":"Cameron Bancroft","links":{"mobile":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/501011.html"}},"web":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/501011.html"}}}}},{"id":325009,"type":"athlete","uid":"s:200~a:267192","guid":"7c295f23-5cd0-38ce-85d7-de94ff541b6f","description":"Steven Smith","sportId":200,"athleteId":267192,"athlete":{"id":267192,"description":"Steven Smith","links":{"mobile":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/267192.html"}},"web":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/267192.html"}}}}},{"id":330493,"type":"athlete","uid":"s:200~a:219889","guid":"7076562c-cbf2-1887-ff84-35804ed87f66","description":"David Warner","sportId":200,"athleteId":219889,"athlete":{"id":219889,"description":"David Warner","links":{"mobile":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/219889.html"}},"web":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/219889.html"}}}}},{"id":292021,"type":"athlete","uid":"s:200~a:489889","guid":"51ff0cb3-370b-1414-da51-37b2332e8da4","description":"Pat Cummins","sportId":200,"athleteId":489889,"athlete":{"id":489889,"description":"Pat Cummins","links":{"mobile":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/489889.html"}},"web":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/489889.html"}}}}},{"id":304361,"type":"athlete","uid":"s:200~a:311592","guid":"c061df98-493e-01c7-bbf3-479c94957802","description":"Mitchell Starc","sportId":200,"athleteId":311592,"athlete":{"id":311592,"description":"Mitchell Starc","links":{"mobile":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/311592.html"}},"web":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/311592.html"}}}}},{"id":333799,"type":"athlete","uid":"s:200~a:288284","guid":"e77305b4-97e5-57d4-297b-a57adeaeaddd","description":"Josh Hazlewood","sportId":200,"athleteId":288284,"athlete":{"id":288284,"description":"Josh Hazlewood","links":{"mobile":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/288284.html"}},"web":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/288284.html"}}}}},{"id":323502,"type":"athlete","uid":"s:200~a:272279","guid":"ef9635dc-c21a-9ca4-aaff-bb5a4e25cae5","description":"Nathan Lyon","sportId":200,"athleteId":272279,"athlete":{"id":272279,"description":"Nathan Lyon","links":{"mobile":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/272279.html"}},"web":{"athletes":{"href":"https://www.cricinfo.com/ci/content/player/272279.html"}}}}},{"id":151721,"type":"team","uid":"s:200~t:2","guid":"c58c17dc-3c34-d242-8a8e-56514479370c","description":"Australia","sportId":200,"teamId":2,"team":{"id":2,"description":"Australia","abbreviation":"AUS","shortDisplayName":"AUS","links":{"mobile":{"teams":{"href":"https://www.espn.in/cricket/team/_/id/2/australia"}},"web":{"teams":{"href":"https://www.espn.in/cricket/team/_/id/2/australia"}}}}},{"id":11160,"type":"league","uid":"s:200","guid":"b44c545f-8bb4-3505-8019-a0ac3c71db1f","description":"Cricket","sportId":200,"leagueId":200,"league":{"id":200,"description":"Cricket","links":{"mobile":{},"web":{}}}},{"id":702321,"type":"contributor","guid":"f9796a5b-1b82-39b9-9a42-39b79804d098","description":"Alex Malcolm","slug":"alex-malcolm","contributor":{"id":3034,"description":"Alex Malcolm"}}],"keywords":["Usman Khawaja","Cameron Bancroft","Steven Smith","David Warner","Pat Cummins","Mitchell Starc","Josh Hazlewood","Nathan Lyon","Australia","Cricket","Alex Malcolm"],"story":"<photo1><p><a href=\"http://www.espncricinfo.com/cricketers/usman-khawaja-215155\">Usman Khawaja</a> has claimed the entire <a href=\"http://www.espncricinfo.com/team/australia-2\">Australia</a> team was involved in the sandpaper plot in 2018, including using it on the ball in the <a href=\"https://www.cricinfo.com/series/aus-tour-of-sa-2017-18-1075977/south-africa-vs-australia-2nd-test-1075983/full-scorecard\">Gqeberha Test</a> prior to <a href=\"https://www.cricinfo.com/series/aus-tour-of-sa-2017-18-1075977/south-africa-vs-australia-3rd-test-1075984/full-scorecard\">Cape Town</a>, and that he was never interviewed by Cricket Australia's investigator about the incident despite sitting next to <a href=\"http://www.espncricinfo.com/cricketers/cameron-bancroft-501011\">Cameron Bancroft</a> in the dressing room.</p><p>Khawaja is set to detail his explosive claims in his autobiography <i>Sabr</i> that will be published on Tuesday. He had <a href=\"http://www.espncricinfo.com/story/pat-cummins-unfazed-by-potential-revelations-from-usman-khawaja-s-autobiography-1557655\">already briefed Australia captain Pat Cummins and CA CEO Todd Greenberg</a> about the book. Khawaja has written the book himself without any help from an established writer or journalist.</p><p>But in an interview with the Nine papers on Saturday, three days out from the book's release, Khawaja has revealed what will be in it regarding the controversial \"Sandpapergate\" incident, stating that the entire team knew about the use of sandpaper on the ball in Cape Town and that it had been used in the previous Test as well.</p><alsosee></p><p>\"It was all of us. Not the batters, not the bowlers, not the staff. All of us,\" Khawaja told Nine.</p><p>Up until now, the long-held public narrative from both CA and the players and staff members involved in the incident was that only <a href=\"http://www.espncricinfo.com/cricketers/steven-smith-267192\">Steven Smith</a>, <a href=\"http://www.espncricinfo.com/cricketers/david-warner-219889\">David Warner</a> and Bancroft were responsible for it. <a href=\"http://www.espncricinfo.com/story/steven-smith-david-warner-banned-for-12-months-by-cricket-australia-1141869\">Smith and Warner were banned for a year</a> from playing international and domestic cricket while Bancroft was banned for nine months. Warner, who was Test vice-captain at the time, was handed an additional penalty of being banned from all leadership positions in international and Australian domestic cricket for life. That ban was later overturned in 2024 which allowed him to captain Sydney Thunder in the BBL.</p><p>In 2021, Bancroft gave an interview to the <i>Guardian</i> where he stated under questioning that it was <a href=\"http://www.espncricinfo.com/story/cameron-bancroft-self-explanatory-bowlers-aware-of-ball-tampering-tactics-newlands-test-1263197\">\"self-explanatory\" that the bowlers had awareness that the ball was being tampered with</a> in Cape Town. In response to that interview Cummins, Mitchell Starc, Josh Hazlewood and Nathan Lyon released a <a href=\"http://www.espncricinfo.com/story/newlands-ball-tampering-cummins-starc-hazlewood-lyon-want-rumour-mongering-and-innuendo-to-stop-1263373\">joint statement</a> denying any knowledge of ball tampering saying, \"we did not know a foreign substance was taken onto the field to alter the condition of the ball until we saw the images on the big screen at Newlands\".</p><p>Khawaja said he did not want to be the one revealing the truth but felt an obligation to do so.</p><p><photo2></p><p>\"In an ideal world, I don't want to do this,\" Khawaja said. \"I don't want to be the one who comes out and talks about the truth. The issue is that I genuinely thought after eight years the truth would have been out by now.</p><p>\"Maybe I thought Davey would have exposed it, or someone else would have talked about it more. I just didn't think it was going to come down to this. But the longer it's gone on for, and right from the very start, I've been on the train of collectively taking it.</p><p>\"Even in the change rooms when I was talking to them after the game. I said, 'Take this as a team'. We did this as a team. We knew what was going on, and we have to take it as a team, and so I was always of that stance.</p><p>\"Obviously, it didn't work that way, and those three guys got crucified.</p><p>\"I've seen Davey over the last eight years just get nailed bad over and over again, and it's taken a big man not to say anything and just to stay quiet.</p><p>\"And he's just copped it and he's copped it and he's copped it.</p><p>\"And then 'Bangers' [Bancroft] in the same note, particularly, he played a little bit of Test cricket after that, but then never came back in, even though he's been scoring a lot of runs. He's been a terrific cricketer for a long time, but I know it's something that hangs over his head.</p><p>\"Even Steve Smith. Steve's lucky, the greatest batsman of my generation. He came back from that, and he's come back as good as he ever was in that first Ashes series, and it's kind of been forgotten for him in some respects. But I know he has never ever forgotten that year and how it all panned out.</p><p>\"But I'm not doing this for any other reason than I think it's the right thing to do. I've always felt like there's more to life than just cricket, and these guys, in some respect, deserve that justice. And it just doesn't feel like anyone's going to give it to them. None of those three want to be the first to say anything. And rightly so, it will just be hearsay and 'their word' if they do. They needed someone else to say something.\"</p><p><photo3><p>Khawaja also revealed that he was never interviewed by CA about the incident. Between the Cape Town and Johannesburg Tests, then CA CEO James Sutherland sent then CA head of integrity Iain Roy and team performance manager Pat Howard to Cape Town to conduct a code-of-conduct investigation into the events of the match. That investigation led to the punishments of Smith, Warner and Bancroft.</p><p>\"I was sitting next to Cam Bancroft that whole Test match, and I didn't get interviewed,\" Khawaja said. \"I thoroughly feel that I didn't get interviewed because of that, because they knew that I wanted to take it as a team, because they knew I was ready to tell the truth if I was interviewed.</p><p>\"And I was waiting for my phone to ring. It just never rang, and then the penalties were given, and I couldn't believe it.\"</p><p>Roy was <a href=\"http://www.espncricinfo.com/story/cricket-australia-parts-ways-with-newlands-investigator-iain-roy-1148251\">removed from his role three months later</a>. Sutherland <a href=\"http://www.espncricinfo.com/story/james-sutherland-resigns-as-cricket-australia-chief-executive-1148634\">quit his post</a> in the same week after 17 years in the role. Howard <a href=\"http://www.espncricinfo.com/story/howard-s-end-should-mark-major-cricket-australia-shift-1165184\">left his role in November</a> following a <a href=\"http://www.espncricinfo.com/story/daniel-brettig-review-gives-ca-board-more-than-it-bargained-for-1163617\">damning cultural review into Australian cricket</a>.</p><p>CA released a statement following Khawaja's interview with Nine saying it was comfortable with the integrity process of the entire incident.</p><p>\"There has been a great deal of speculation in the eight years since the 2018 Cape Town Test, including extensive media coverage throughout last month's series in South Africa,\" the CA statement said.</p><p>\"During this time there has been the ongoing opportunity to present any relevant information, and this remains the case.</p><p>\"All relevant information presented to CA to date has been properly considered and we remain comfortable with the findings of our integrity process.\"</p><p>Khawaja also claims the South Africa team were \"far better\" at working on the ball than Australia and that his team were \"trying to keep up with them\". He said he has details of what they were doing in the book. Then South Africa skipper Faf du Plessis has stated on a number of occasions that his team were also trying to get the ball to reverse via unconventional methods and he had previously been sanctioned twice for ball tampering, including for using mints in a Test match against Australia.</p><p>\"They were so good, and I discuss in a little bit of detail about what I'd heard from one of their players and what they were doing,\" Khawaja said.</p>","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Alex Malcolm","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50402294"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50402294"}},"mobile":{"href":"http://m.espn.go.com/wireless/story?storyId=50402294"},"web":{"href":"https://www.espn.com/cricket/story/_/id/50402294/it-was-all-us-khawaja-exposes-sandpaper-details-2018","legacy":{"href":"http://www.espncricinfo.com/ci/content/story/1561704.html"}}},"premium":false},{"id":50402471,"nowId":"1-50402471","contentKey":"50402471-1-5-1","dataSourceIdentifier":"b785cd8d9c180","publishedkey":"50402471","type":"HeadlineNews","feedDisplayType":"Default","headline":"Alacaraz bests Fritz, Shelton tops Paul to reach Paris Masters semis","description":"Carlos Alcaraz held off Taylor Fritz and Ben Shelton outlasted Tommy Paul to reach the Paris Masters semifinals while also finalizing the field for the ATP Finals.","title":"Alacaraz, Shelton advance to semifinals of Paris Masters","linkText":"Alacaraz bests Fritz, Shelton tops Paul to reach Paris Masters semis","categorized":"2026-11-06T23:04:08Z","originallyPosted":"2026-11-06T22:51:45Z","lastModified":"2026-11-06T23:04:08Z","published":"2026-11-06T23:04:08Z","root":"tennis","section":"ATP","source":"Associated Press","images":[{"dataSourceIdentifier":"17212f37b4e21","id":50402557,"type":"header","name":"Carlos Alcaraz [600x400]","credit":"Antonio Borga/Eurasia Sport Images/Getty Images","height":400,"width":600,"url":"https://a.espncdn.com/photo/2026/1106/r1742195_600x400_3-2.jpg"}],"related":[{"id":50398236,"dataSourceIdentifier":"cd025212d57a4","publishedkey":"50398236","type":"HeadlineNews","headline":"Jannik Sinner replacing Darren Cahill with Magnus Norman on coaching team","title":"Sinner replacing Cahill with Norman on coaching team","linkText":"Sinner replacing Cahill with Norman on coaching team","source":"Associated Press","images":[{"dataSourceIdentifier":"f4ea4a5cbd431","id":45734953,"type":"header","name":"Jannik Sinner of Italy celebrates with his coach Darren Cahill  [600x400]","credit":"Julian Finney/Getty Images","height":400,"width":600,"url":"https://a.espncdn.com/photo/2025/0713/r1518768_600x400_3-2.jpg"}],"isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50398236"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50398236"}},"mobile":{"href":"http://m.espn.go.com/general/tennis/story?storyId=50398236"},"web":{"href":"https://www.espn.com/tennis/story/_/id/50398236/sinner-replacing-cahill-norman-coaching-team"}},"premium":false},{"id":50393979,"dataSourceIdentifier":"85af4319469c9","publishedkey":"50393979","type":"Story","headline":"WTA Finals preview: Who to watch and who can win","title":"WTA Finals preview: Who to watch and who can win","linkText":"WTA Finals preview: Who to watch and who can win","source":"ESPN","images":[{"dataSourceIdentifier":"7c3a04e85a1f5","id":50394806,"type":"header","name":"Coco Gauff [1296x729]","caption":"Coco Gauff won the WTA Finals in 2024 -- can she escape a tough group and win again?","credit":"Robert Prange/Getty Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/1106/r1741832_3_1296x729_16-9.jpg"}],"byline":"D'Arcy Maine","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50393979"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50393979"}},"mobile":{"href":"http://m.espn.go.com/general/tennis/story?storyId=50393979"},"web":{"href":"https://www.espn.com/tennis/story/_/id/50393979/wta-fina