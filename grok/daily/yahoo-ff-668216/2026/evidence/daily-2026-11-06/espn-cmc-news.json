Imagn Images","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/1106/r1742051_608x342_16-9.jpg"}],"byline":"Ben Solak and Seth Walder","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043542"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043542"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043542"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043542/2026-trade-deadline-grades-latest-best-worst-deals"}},"premium":false}],"categories":[{"id":450385,"type":"athlete","uid":"s:20~l:28~a:4696981","guid":"0be760c4-3eb7-338a-9b0b-20de5895543c","description":"Cam Skattebo","sportId":28,"athleteId":4696981,"athlete":{"id":4696981,"description":"Cam Skattebo","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4696981/cam-skattebo"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4696981/cam-skattebo"}}}}},{"id":489486,"type":"athlete","uid":"s:20~l:28~a:4595348","guid":"44a2174b-1d11-3acf-8e75-fe0c13db47a6","description":"Malik Nabers","sportId":28,"athleteId":4595348,"athlete":{"id":4595348,"description":"Malik Nabers","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4595348/malik-nabers"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4595348/malik-nabers"}}}}},{"id":1352,"type":"team","uid":"s:20~l:28~t:19","guid":"378600ea-2397-8364-8399-b7c1606a49a7","description":"New York Giants","sportId":28,"teamId":19,"team":{"id":19,"description":"New York Giants","abbreviation":"NYG","shortDisplayName":"Giants","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/nyg/new-york-giants"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/nyg/new-york-giants"}}}}},{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":696298,"type":"contributor","guid":"b8dd259e-f5fa-3124-8d1c-5c0caf40d38f","description":"Jordan Raanan","slug":"jordan-raanan","contributor":{"id":2721,"description":"Jordan Raanan"}}],"keywords":["Cam Skattebo","Malik Nabers","New York Giants","NFL","Jordan Raanan"],"story":"<p>EAST RUTHERFORD, N.J. -- <a data-clubhouse-guid=\"378600ea-2397-8364-8399-b7c1606a49a7\" href=\"https://www.espn.com/nfl/team/_/name/nyg/new-york-giants\">New York Giants</a> running back <a data-player-guid=\"0be760c4-3eb7-338a-9b0b-20de5895543c\" href=\"https://www.espn.com/nfl/player/_/id/4696981/cam-skattebo\">Cam Skattebo</a> is unlikely to play on the road against the <a data-clubhouse-guid=\"d1a9b001-1df7-fbd7-ae4c-6ca7065286ec\" href=\"https://www.espn.com/nfl/team/_/name/phi/philadelphia-eagles\">Philadelphia Eagles</a> on Sunday, but wide receiver <a data-player-guid=\"44a2174b-1d11-3acf-8e75-fe0c13db47a6\" href=\"https://www.espn.com/nfl/player/_/id/4595348/malik-nabers\">Malik Nabers</a> is expected to be a \"full go\" without limitations, coach John Harbaugh said Friday.</p>\n<p>Skattebo, who is listed as doubtful for Sunday's game, injured his hamstring in overtime at the <a data-clubhouse-guid=\"595690b3-2161-4913-a7a7-814af2fd2621\" href=\"https://www.espn.com/nfl/team/_/name/hou/houston-texans\">Houston Texans</a> on Oct. 25. He didn't practice this week despite having had a bye week to recover.</p>\n<p>While it doesn't look good for Sunday, Harbaugh didn't want to close the door completely.</p>\n<p>\"Yeah, let's keep it open,\" he said. \"Let's keep it open, let's see what happens.\"</p>\n<p><alsosee></p>\n<p>Skattebo leads the Giants with 418 yards rushing on 98 carries. No other player on the team has 100 yards rushing this season.</p>\n<p>Nabers, who missed practice Thursday because of his right knee, practiced Friday without an injury designation and is expected to play without any limitations.</p>\n<p>\"He practiced fully. He was full participation. It's not an issue,\" Harbaugh said. \"He'll be full go for the game.\"</p>\n<p>Nabers has played all seven games for New York this season after suffering a serious knee injury last season. He leads the team with 48 catches for 605 yards and is looking for his fifth straight 100-yard game Sunday against the Eagles.</p>\n<p>The Giants (4-2-1) are looking for their first win at Lincoln Financial Field since 2013. Last season, Skattebo suffered a fractured ankle in Philadelphia.</p>\n<p>His absence would leave the Giants short-handed at running back. <a data-player-guid=\"6e8f4728-f347-ab07-9112-a1528d0162d7\" href=\"https://www.espn.com/nfl/player/_/id/4040761/devin-singletary\">Devin Singletary</a>, who rushed for the game-winning 30-yard touchdown in Houston after being inactive for several games earlier this season, is expected to be the primary back Sunday. Newcomer <a data-player-guid=\"a6790fee-7e0c-32f3-9003-9d1819c7bbaf\" href=\"https://www.espn.com/nfl/player/_/id/4691889/greg-desrosiers-jr\">Greg Desrosiers Jr</a>. and <a data-player-guid=\"695ff537-e84e-3fff-8706-affe370e5939\" href=\"https://www.espn.com/nfl/player/_/id/4431562/phil-mafah\">Phil Mafah</a> are other likely options.</p>\n<p><a data-player-guid=\"299f83a3-54ea-c2bc-743a-e84fe4e1de18\" href=\"https://www.espn.com/nfl/player/_/id/4360516/tyrone-tracy-jr\">Tyrone Tracy Jr</a>. was placed on injured reserve last week with a hamstring injury.</p>\n<p>Desrosiers was signed off the <a data-clubhouse-guid=\"84caf62b-c753-71ea-a787-44fd224a4294\" href=\"https://www.espn.com/nfl/team/_/name/lac/los-angeles-chargers\">Los Angeles Chargers</a>' practice squad to take Tracy's place last week. He's set to play in his first career game. Mafah has appeared in one game and has five career carries, which came for the <a data-clubhouse-guid=\"b0fc8fb7-9dbe-e574-9008-6f0ee7c6b234\" href=\"https://www.espn.com/nfl/team/_/name/dal/dallas-cowboys\">Dallas Cowboys</a> against the Giants in Week 18 last season.</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Jordan Raanan","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50402162"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50402162"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50402162"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50402162/giants-cam-skattebo-doubtful-vs-eagles-nabers-full-go"}},"premium":false},{"id":50402128,"nowId":"1-50402128","contentKey":"50402128-1-5-1","dataSourceIdentifier":"2b2dda210abc4","publishedkey":"50402128","type":"HeadlineNews","feedDisplayType":"Default","headline":"Sources: Mariners to hire Yankees' Tanner Swanson as bench coach","description":"Yankees catching coach and field coordinator Tanner Swanson is joining the Mariners' staff as bench coach, a source confirmed to ESPN on Friday.","title":"Sources -- Mariners to hire Yankees' Swanson as bench coach","linkText":"Sources: Mariners to hire Yankees' Swanson as bench coach","categorized":"2026-11-06T22:18:04Z","originallyPosted":"2026-11-06T22:03:30Z","lastModified":"2026-11-06T22:18:04Z","published":"2026-11-06T22:18:04Z","root":"mlb","section":"MLB","images":[{"dataSourceIdentifier":"18a34634a4e7d","id":31040406,"type":"header","name":"Mariners_logo 161024 [600x400] - Copy","alt":"Mariners logo","credit":"Gavin Baker/Icon SMI/Corbis/Getty Images","height":400,"width":600,"url":"https://a.espncdn.com/photo/2016/1024/r144515_600x400_3-2.jpg"}],"related":[{"id":50384326,"dataSourceIdentifier":"f0e02b24457d7","publishedkey":"50384326","type":"HeadlineNews","headline":"Mariners introduce first-time manager Jason Kanzler","title":"Mariners introduce first-time manager Jason Kanzler","linkText":"Kanzler rides atypical path to Mariners job: 'He left us no choice'","source":"Associated Press","images":[{"dataSourceIdentifier":"aceb61df0c59d","id":50384427,"type":"header","name":"Kanzler [600x600]","caption":"Jason Kanzler comes from an analytics and data-friendly background, something the club seemed to want after firing Dan Wilson. \n","credit":"AP Photo/Stephen Brashear","height":600,"width":600,"url":"https://a.espncdn.com/photo/2026/1105/r1741360_600x600_1-1.jpg"}],"isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50384326"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50384326"}},"mobile":{"href":"http://m.espn.go.com/mlb/story?storyId=50384326"},"web":{"href":"https://www.espn.com/mlb/story/_/id/50384326/mariners-introduce-first-manager-jason-kanzler"}},"premium":false},{"id":50359247,"dataSourceIdentifier":"1a91a9bad7adc","publishedkey":"50359247","type":"Story","headline":"Rankings, contract projections: Top 50 2026-27 MLB free agents","title":"Rankings, contract projections: Top 50 2026-27 MLB free agents","linkText":"From Tarik Skubal to ...? Rankings, contract projections for the top 50 MLB free agents","images":[{"dataSourceIdentifier":"d31a45a730613","id":50331695,"type":"header","name":"Ranking the top 50 MLB free agents [608x342]","caption":"Freddy Peralta, Tarik Skubal, Randy Arozarena and Seiya Suzuki are among the top free agents.","alt":"Freddy Peralta, Tarik Skubal, Randy Arozarena & Seiya Suzuki","credit":"ESPN","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/1030/mlb_ranking_the_top_50_free_agents_16x9_608x342.jpg"}],"byline":"Kiley McDaniel","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50359247"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50359247"}},"mobile":{"href":"http://m.espn.go.com/mlb/story?storyId=50359247"},"web":{"href":"https://www.espn.com/mlb/story/_/id/50359247/rankings-contract-projections-top-mlb-free-agents"}},"premium":false}],"categories":[{"id":409224,"type":"topic","guid":"52313677-19f8-b106-ec91-d8d17e6087fe","description":"news","sportId":0,"topicId":781},{"id":80311,"type":"league","uid":"s:1~l:10","guid":"b38f959b-7865-31ac-8841-b88355519e10","description":"MLB","sportId":10,"leagueId":10,"league":{"id":10,"description":"MLB","abbreviation":"MLB","links":{"mobile":{"leagues":{"href":"https://www.espn.com/mlb/"}},"web":{"leagues":{"href":"https://www.espn.com/mlb/"}}}}},{"id":343,"type":"team","uid":"s:1~l:10~t:12","guid":"56d60582-088f-6848-5180-1fb04440cf87","description":"Seattle Mariners","sportId":10,"teamId":12,"team":{"id":12,"description":"Seattle Mariners","abbreviation":"SEA","shortDisplayName":"Mariners","links":{"mobile":{"teams":{"href":"https://www.espn.com/mlb/team/_/name/sea/seattle-mariners"}},"web":{"teams":{"href":"https://www.espn.com/mlb/team/_/name/sea/seattle-mariners"}}}}}],"keywords":["news","MLB","Seattle Mariners"],"story":"<p>The <a data-clubhouse-guid=\"56d60582-088f-6848-5180-1fb04440cf87\" href=\"https://www.espn.com/mlb/team/_/name/sea/seattle-mariners\">Seattle Mariners</a> are hiring <a data-clubhouse-guid=\"2b9cedf3-ce60-0bcf-fafe-8cd055255685\" href=\"https://www.espn.com/mlb/team/_/name/nyy/new-york-yankees\">New York Yankees</a> catching coach and field coordinator Tanner Swanson as bench coach, a source confirmed to ESPN on Friday, two days after the club <a href=\"https://www.espn.com/mlb/story/_/id/50369972/mariners-hire-kanzler-manager-replace-fired-wilson\" target=\"_blank\">introduced Jason Kanzler as manager</a>.</p>\n<p>A native of Washington, Swanson joined the Yankees' coaching staff for the 2020 season after three seasons as minor league catching coordinator with the <a data-clubhouse-guid=\"a6e97b3f-4244-98be-79a2-f4b33f3365e6\" href=\"https://www.espn.com/mlb/team/_/name/min/minnesota-twins\">Minnesota Twins</a>. He was held in high regard within the Yankees' organization for his work with catchers, including current starting catcher <a data-player-guid=\"9445aadd-cdd0-3bb7-8549-181f92ac7660\" href=\"https://www.espn.com/mlb/player/_/id/4683349/austin-wells\">Austin Wells</a> who has established himself as a premier defensive catcher after rising through the farm system with questions about his future behind the plate.</p>\n<p><alsosee></p>\n<p>Swanson was bench coach for Great Britain in the 2026 World Baseball Classic. In July, he served as acting manager for the Yankees in a game against the <a data-clubhouse-guid=\"f8a579c6-08b9-7584-141d-317d0645763b\" href=\"https://www.espn.com/mlb/team/_/name/tb/tampa-bay-rays\">Tampa Bay Rays</a> after manager Aaron Boone and bench coach Brad Ausmus were ejected.</p>\n<p>His relative lack of experience did not discourage the Mariners from pairing him with Kanzler, who has never managed at any level. Kanzler, 36, had been the Chicago Cubs' director of player development. He was selected to replace Dan Wilson, the longtime catcher who was fired after a disastrous 2026 season.</p>\n<p>The New York Post was the first to report the news of Swanson's hiring.</p>\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Jorge Castillo","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50402128"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50402128"}},"mobile":{"href":"http://m.espn.go.com/mlb/story?storyId=50402128"},"web":{"href":"https://www.espn.com/mlb/story/_/id/50402128/sources-mariners-hire-yankees-swanson-bench-coach"}},"premium":false},{"id":50393648,"nowId":"1-50393648","contentKey":"50393648-1-21-1","dataSourceIdentifier":"84bde361f6846","publishedkey":"soccer401879242","type":"Recap","gameId":"401879242","headline":"Barry's brace propels Everton up to 5th with win over Coventry","description":"Thierno Barry's hot streak fired Everton into the top five as they came from behind to beat Coventry 3-1.","linkText":"Barry's brace propels Everton up to 5th with win over Coventry","categorized":"2026-11-06T22:24:45Z","originallyPosted":"2026-11-06T22:00:00Z","lastModified":"2026-11-06T22:10:12Z","published":"2026-11-06T22:00:00Z","section":"Soccer","images":[{"dataSourceIdentifier":"872af3ebe86b4","id":50402000,"type":"header","name":"Barry Everton celeb [1296x729]","caption":"Thierno Barry celebrates scoring his second goal in Everton's win over Coventry City.","alt":"Thierno Barry of Everton celebrates scoring his teamâs second goal during the Premier League 2026/27 match between Everton and Coventry City at Hill Dickinson Stadium on November 06, 2026 in Liverpool, England","credit":"Carl Recine/Getty Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/1106/r1742160_1296x729_16-9.jpg"}],"video":[],"categories":[{"id":81497,"type":"league","uid":"s:600","guid":"119cfa41-71d4-39bf-a790-6273a52b0259","description":"Soccer","sportId":600,"leagueId":600,"league":{"id":600,"description":"Soccer","links":{"mobile":{"leagues":{"href":"https://www.espn.com/soccer/"}},"web":{"leagues":{"href":"https://www.espn.com/soccer/"}}}}},{"id":137781,"type":"league","uid":"s:600~l:700","guid":"6949f3af-300c-35f1-beab-b95669eedd38","description":"English Premier League","sportId":600,"leagueId":23,"league":{"id":700,"description":"English Premier League","abbreviation":"Premier League","links":{"mobile":{"leagues":{"href":"https://www.espn.com/soccer/league/_/name/eng.1"}},"web":{"leagues":{"href":"https://www.espn.com/soccer/league/_/name/eng.1"}}}}},{"id":142300,"type":"team","uid":"s:600~t:368","guid":"c531d4dd-ea53-c1fc-9c91-c7f8f31b5a40","description":"Everton","sportId":600,"teamId":368,"team":{"id":368,"description":"Everton","abbreviation":"EVE","shortDisplayName":"Everton","links":{"mobile":{"teams":{"href":"https://www.espn.com/soccer/club/_/id/368/everton"}},"web":{"teams":{"href":"https://www.espn.com/soccer/club/_/id/368/everton"}}}}},{"id":142250,"type":"team","uid":"s:600~t:388","guid":"05650a8f-d953-4acc-dd85-260d59aa4c8f","description":"Coventry City","sportId":600,"teamId":388,"team":{"id":388,"description":"Coventry City","abbreviation":"COV","shortDisplayName":"Coventry","links":{"mobile":{"teams":{"href":"https://www.espn.com/soccer/club/_/id/388/coventry-city"}},"web":{"teams":{"href":"https://www.espn.com/soccer/club/_/id/388/coventry-city"}}}}},{"id":497983,"type":"athlete","uid":"s:600~a:301166","guid":"3620afac-7ad7-34c8-ba6b-3c78a011c2a5","description":"Thierno Barry","sportId":600,"athleteId":301166,"athlete":{"id":301166,"description":"Thierno Barry","links":{"mobile":{"athletes":{"href":"https://www.espn.com/soccer/player/_/id/301166/thierno-barry"}},"web":{"athletes":{"href":"https://www.espn.com/soccer/player/_/id/301166/thierno-barry"}}}}},{"type":"event","uid":"s:600~l:700~e:401879242","guid":"6e2e78b6-0d34-3668-bac5-d315ccbb9a4a","description":"Coventry City @ Everton","eventId":401879242,"event":{"id":401879242,"sport":"soccer","league":"eng.1","description":"Coventry City @ Everton"}}],"keywords":["Soccer","English Premier League","Everton","Coventry City","Thierno Barry","Coventry City @ Everton"],"story":"<p>Thierno Barry's hot streak fired <a data-clubhouse-guid=\"c531d4dd-ea53-c1fc-9c91-c7f8f31b5a40\" href=\"http://espn.com/soccer/team?id=368\">Everton</a> into the top five as they came from behind to beat Coventry 3-1.</p>\n<p>Only <a data-clubhouse-guid=\"94fd5d7e-35b1-9d52-c9f2-4a37259bea36\" href=\"http://espn.com/soccer/team?id=382\">Manchester City</a> striker <a data-player-guid=\"63b48f6c-a73d-78e7-71b9-21edae6b0e31\" href=\"http://espn.com/soccer/player/_/id/253989/erling-haaland\">Erling Haaland</a> (nine) has more league goals this season after the 24-year-old's double turned things around against former Everton manager Frank Lampard's side.</p>\n<p>Barry's rawness can be a source of frustration, as evidenced in the first half when he wasted a good chance to shoot by failing to get the ball out from under his feet, but he came alive inside the six-yard box after the break.</p>\n<p>Trailing to Yann Gboho's first goal for Coventry in only his second league appearance, the French forward headed an equaliser before doubling his tally by bundling in a scrappy effort from barely two yards out.</p>\n<p>Lampard will argue his side should have had at least one penalty when <a data-player-guid=\"6964d8ec-38d0-54fc-c7ff-10edaa6eba7b\" href=\"http://espn.com/soccer/player/_/id/155226/james-tarkowski\">James Tarkowski</a> appeared to pull the hair of <a data-player-guid=\"78c15c05-709a-373a-862c-43fe373c6204\" href=\"http://espn.com/soccer/player/_/id/387659/caleb-yirenkyi\">Caleb Yirenkyi</a> with the score goalless in the first half, but their own defending left a lot to be desired.</p>\n<p>Barry has now scored in three successive games for first time for Everton and only second time in his career.</p>\n<p>He has six in his last seven in all competitions and 10 for the season -- two more than he managed in his maiden campaign.</p>\n<p><photo1></p>\n<p>Somewhat prophetically boss David Moyes, equalling Harry Catterick's record of 592 matches in charge, had said at his pre-match news conference that \"Erling Haaland should be worried.\"</p>\n<p>And while, realistically, the <a data-clubhouse-guid=\"2fceb68b-55e5-2028-6ca3-42869377b23e\" href=\"http://espn.com/soccer/team?id=464\">Norway</a> international will not be losing any sleep at the thought Barry's form as the club's only recognised striker is proving a major boost.</p>\n<p>With <a data-player-guid=\"209db1df-36ce-4f86-83ac-f5bc52b6566c\" href=\"http://espn.com/soccer/player/_/id/252389/kiernan-dewsbury-hall\">Kiernan Dewsbury-Hall</a> chipping in with goals from midfield, scoring the third nine minutes from time, to add to his all-round creativity Moyes is squeezing everything out of his limited resources.</p>\n<p>A third successive win also took the focus off the circus surrounding <a data-player-guid=\"dd81ca57-15c8-00ac-89e7-ea0f55c08509\" href=\"http://espn.com/soccer/player/_/id/172850/jack-grealish\">Jack Grealish</a>.</p>\n<p>He has been absent for the last four matches after being disciplined by the club for missing training, but he returned to Finch Farm earlier in the day to begin a tailored programme, which is likely to see him return to the first-team fold after the international break.</p>\n<p>A nondescript first half which began with Everton in the ascendency finished with the visitors in command and was notable mainly for Tarkowski's tangle with Yirenkyi as they challenged for a cross.</p>\n<p>His grasp of the midfielder's hair was so slight it appeared to go unnoticed by everyone except the player and no action was taken by VAR.</p>\n<p>Coventry's second penalty appeal was checked by the officials but Vitalii Mykolenko's challenge on <a data-player-guid=\"7f1d254c-e028-a3e1-973a-0d7525e8db89\" href=\"http://espn.com/soccer/player/_/id/194686/taiwo-awoniyi\">Taiwo Awoniyi</a> was ruled to have been made fractionally outside the box.</p>\n<p>But when the ball bounced around the area after the visitors were able to play their way from right to left Gboho, surrounded by three Everton players, poked through a shot which appeared to take Pickford by surprise as it crept over the line.</p>\n<p>The lead lasted four minutes as Barry barely had to get off the ground to head home Mykolenko's cross after Jay Dasilva crumpled to the floor.</p>\n<p>Within five minutes they were ahead as he again outjumped Dasilva at the far post to bundle home off his midriff with a panicked goalkeeper <a data-player-guid=\"f5bff9c6-9946-3749-959a-a406c61d3005\" href=\"http://espn.com/soccer/player/_/id/307069/carl-rushworth\">Carl Rushworth</a> unable to keep it out.</p>\n<p>Dewsbury-Hall made the result safe with a fine angled finish to displace Merseyside neighbours <a data-clubhouse-guid=\"a47fbcec-c948-cf4c-9e41-3dfa37588c9c\" href=\"http://espn.com/soccer/team?id=364\">Liverpool</a> in fifth place.</p>\n\n\n\n\n","allowComments":true,"allowContentReactions":false,"allowSearch":true,"byline":"PA","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50393648"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50393648"}},"mobile":{"href":"http://m.espn.go.com/soccer/story?storyId=50393648"},"web":{"href":"http://www.espn.com/soccer/report/_/gameId/401879242"}},"premium":false},{"id":50402041,"nowId":"1-50402041","contentKey":"50402041-1-5-1","dataSourceIdentifier":"55b7b772ad8b2","publishedkey":"50402041","type":"HeadlineNews","feedDisplayType":"Default","headline":"Warriors' Kristaps Porzingis to 'step away,' prioritize health","description":"Kristaps Porzingis has announced that he will \"step away\" from the NBA to prioritize his health. He has not played for the Warriors this season.","title":"Warriors' Kristaps Porzingis to 'step away,' prioritize health","linkText":"Warriors' Porzingis to 'step away' from NBA to prioritize his health","categorized":"2026-11-06T22:35:31Z","originallyPosted":"2026-11-06T21:50:14Z","lastModified":"2026-11-06T22:35:31Z","published":"2026-11-06T22:35:31Z","root":"nba","section":"NBA","images":[{"dataSourceIdentifier":"661b409cccae3","id":50052232,"type":"header","name":"Kristaps Porzingis [1296x729]","alt":"Kristaps Porzingis","credit":"Cary Edmondson/Imagn Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/0928/r1722984_1296x729_16-9.jpg"}],"related":[{"id":50299136,"dataSourceIdentifier":"388c989046cb7","publishedkey":"50299136","type":"Story","headline":"What are the Warriors' options as Kristaps Porzingis remains away from the team?","title":"Warriors' options with Kristaps Porzingis: Biggest questions","linkText":"Will Kristaps Porzingis play for the Warriors again? What we're heari