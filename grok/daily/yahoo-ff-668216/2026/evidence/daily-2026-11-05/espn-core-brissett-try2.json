r","name":"Bills pass rush [1296x729]","credit":"Timothy T Ludwig/Getty Images","height":729,"width":1296,"url":"https://a.espncdn.com/photo/2026/1101/r1739702_1296x729_16-9.jpg"}],"byline":"Jamison Hensley","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50378134"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50378134"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50378134"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50378134/sources-ravens-qb-tyler-snoop-huntley-season"}},"premium":false},{"id":50043471,"dataSourceIdentifier":"bfbfa442722b8","publishedkey":"50043471","type":"Story","headline":"2026 NFL trade deadline updates: Jacoby Brissett, Jeffery Simmons on the move","title":"2026 NFL trade deadline updates: Latest deals, news, buzz","linkText":"Tracking NFL trades: Catch up on all eight moves ahead of the deadline","images":[{"dataSourceIdentifier":"941c5fcf99ff8","id":49964552,"type":"header","name":"Jacoby Brissett [608x342]","credit":"CHRIS TORRES/EPA/Shutterstock","height":342,"width":608,"url":"https://a.espncdn.com/photo/2026/0917/r1718044_608x342_16-9.jpg"}],"byline":"ESPN staff","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50043471"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50043471"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50043471"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50043471/2026-trade-deadline-updates-latest-news-deals-terms"}},"premium":false}],"categories":[{"id":409224,"type":"topic","guid":"52313677-19f8-b106-ec91-d8d17e6087fe","description":"news","sportId":0,"topicId":781},{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":2830,"type":"team","uid":"s:20~l:28~t:33","guid":"38248455-3da4-84e4-8090-98b5cc38ffdc","description":"Baltimore Ravens","sportId":28,"teamId":33,"team":{"id":33,"description":"Baltimore Ravens","abbreviation":"BAL","shortDisplayName":"Ravens","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/bal/baltimore-ravens"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/bal/baltimore-ravens"}}}}},{"id":1583,"type":"team","uid":"s:20~l:28~t:22","guid":"8fc7b962-95e1-3cb8-6a7d-b499de9ad546","description":"Arizona Cardinals","sportId":28,"teamId":22,"team":{"id":22,"description":"Arizona Cardinals","abbreviation":"ARI","shortDisplayName":"Cardinals","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals"}}}}},{"id":152903,"type":"athlete","uid":"s:20~l:28~a:2578570","guid":"efcb42e5-0bef-62d1-b58b-dbc17fde2479","description":"Jacoby Brissett","sportId":28,"athleteId":2578570,"athlete":{"id":2578570,"description":"Jacoby Brissett","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/2578570/jacoby-brissett"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/2578570/jacoby-brissett"}}}}},{"id":696306,"type":"contributor","guid":"9e75a49e-54ea-333b-b3e4-5ddc7b66f32d","description":"Jamison Hensley","slug":"jamison-hensley","contributor":{"id":2078,"description":"Jamison Hensley"}},{"id":696416,"type":"contributor","guid":"ff2bd78b-f473-3bf6-bd0e-12c35dabe606","description":"Josh Weinfuss","slug":"josh-weinfuss","contributor":{"id":2330,"description":"Josh Weinfuss"}}],"keywords":["news","NFL","Baltimore Ravens","Arizona Cardinals","Jacoby Brissett","Jamison Hensley","Josh Weinfuss"],"story":"<p>The <a data-clubhouse-guid=\"8fc7b962-95e1-3cb8-6a7d-b499de9ad546\" href=\"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals\">Arizona Cardinals</a> are finalizing a trade to send quarterback <a data-player-guid=\"efcb42e5-0bef-62d1-b58b-dbc17fde2479\" href=\"https://www.espn.com/nfl/player/_/id/2578570/jacoby-brissett\">Jacoby Brissett</a> to the <a data-clubhouse-guid=\"38248455-3da4-84e4-8090-98b5cc38ffdc\" href=\"https://www.espn.com/nfl/team/_/name/bal/baltimore-ravens\">Baltimore Ravens</a>, sources told ESPN's Adam Schefter and NFL Network's Ian Rapoport.</p>\n<p>The deal is expected to be completed this weekend.</p>\n<p>\"Out of respect for the process and just working to get stuff finalized, I mean, I really don't have much of a comment on it, but we're going to let the process play out with that,\" Cardinals coach Mike LaFleur said Wednesday.</p>\n<p>Before the looming trade to Baltimore, the Cardinals restructured the Brissett's contract, converting $2.7 million of his remaining $5.4 million salary into a signing bonus, ESPN's Field Yates reports.</p>\n<p>The Ravens will now owe Brissett a base salary of $2.7 million if the deal is completed before their Thursday night and $2.43 million if it is not completed Thursday. He has incentives in his deal as well to make additional money.</p>\n<p><inline1></p>\n<p>The Ravens lost starting quarterback <a data-player-guid=\"7d76fbb1-1c5e-d9f4-954f-cad43f720ae2\" href=\"https://www.espn.com/nfl/player/_/id/3916387/lamar-jackson\">Lamar Jackson</a> to a potentially season-ending thumb injury that will require surgery. Backup <a data-player-guid=\"749ba0ed-1951-e15d-e708-5e95557294de\" href=\"https://www.espn.com/nfl/player/_/id/4035671/tyler-huntley\">Tyler \"Snoop\" Huntley</a> has a turf toe injury that will end his season, sources told Schefter and Rapoport earlier Wednesday.</p>\n<p>Undrafted rookie quarterback <a data-player-guid=\"09beee77-ea78-15ba-d273-b3e664772873\" href=\"https://www.espn.com/nfl/player/_/id/4429582/joe-fagnano\">Joe Fagnano</a> will start Thursday night's game for Baltimore against the <a data-clubhouse-guid=\"ca6fb778-cbf6-d9a3-3e93-01230335fcab\" href=\"https://www.espn.com/nfl/team/_/name/jax/jacksonville-jaguars\">Jacksonville Jaguars</a>. <a data-player-guid=\"eab1203b-be8c-55a5-98a5-5c4d5ada830a\" href=\"https://www.espn.com/nfl/player/_/id/4428512/kedon-slovis\">Kedon Slovis</a> and <a data-player-guid=\"b8ce56e4-d970-98cd-1c64-125bdf6a3c0d\" href=\"https://www.espn.com/nfl/player/_/id/4368343/austin-reed\">Austin Reed</a>, both of whom were acquired this week, are backing up Fagnano.</p>\n<p>Baltimore's three active quarterbacks for Thursday -- Fagnano, Slovis and Reed -- lack experience. They have combined for no previous starts, 44 snaps and 23 passes attempted.</p>\n<p>With the Ravens getting an 11-day break after Thursday, Brissett should have enough time to be ready for the Nov. 16 Monday night game against the <a data-clubhouse-guid=\"84caf62b-c753-71ea-a787-44fd224a4294\" href=\"https://www.espn.com/nfl/team/_/name/lac/los-angeles-chargers\">Los Angeles Chargers</a>.</p>\n<p>The Ravens (4-4) have lost three straight games to fall into last place in the AFC North. The injuries at quarterback have taken a toll on Baltimore, which has failed to score more than 13 points in three straight games for the first time since 2005.</p>\n<p>Brissett will reunite with Ravens quarterbacks coach Israel Woolfork, who held the same position last season with Brissett in Arizona. The two also worked together in 2022 with the <a data-clubhouse-guid=\"539babc5-e5fb-753b-8ae1-c15032a91ef4\" href=\"https://www.espn.com/nfl/team/_/name/cle/cleveland-browns\">Cleveland Browns</a>.</p>\n<p>Brissett was benched this week by the Cardinals, who named <a data-player-guid=\"a64e025b-8608-fd26-e1f8-df83133d7a59\" href=\"https://www.espn.com/nfl/player/_/id/4038524/gardner-minshew-ii\">Gardner Minshew II</a> their starting quarterback moving forward. Rookie <a data-player-guid=\"baca19aa-8fab-3a5e-9bb0-6cfcbcbc1b57\" href=\"https://www.espn.com/nfl/player/_/id/4430841/carson-beck\">Carson Beck</a> was named the backup with Brissett as the third-stringer.</p>\n<p><alsosee></p>\n<p>Brissett had started the past 20 games for Arizona dating to Week 6 of last season before he was benched late in the third quarter of Sunday's 33-30 overtime victory over the <a data-clubhouse-guid=\"b0fc8fb7-9dbe-e574-9008-6f0ee7c6b234\" href=\"https://www.espn.com/nfl/team/_/name/dal/dallas-cowboys\">Dallas Cowboys</a>. Brissett asked for a trade Monday when LaFleur called to tell him about the shake-up in the quarterbacks room, a source told ESPN.</p>\n<p>Discussions about sending Brissett to Baltimore began Sunday after the game, a source told ESPN, and the conversation picked up steam Tuesday afternoon.</p>\n<p>The Cardinals were 3-5 this season with Brissett as the starter and 1-11 last season. Over the past 20 games, Brissett was ranked No. 1 in dropbacks, completions and attempts, third in passing first downs, fourth in completion percentage over expected, fifth in passing yards, and seventh in passing yards and broken sacks. He was sacked 62 times over that stretch, which is tied for the most in the NFL.</p>\n<p>He was contacted a league-high 241 times as well. Brissett led an offense that ranked fourth in time of possession, 10th in yards and turnovers, 16th in total points and yards per game, and 21st in points per game.</p>\n<p>Brissett made headlines in the offseason when, after replacing <a data-player-guid=\"9bef707d-d33f-266b-3020-81900d735915\" href=\"https://www.espn.com/nfl/player/_/id/3917315/kyler-murray\">Kyler Murray</a> as Arizona's starting quarterback last season, he held out for a reworked contract, missing OTAs and holding in during mandatory minicamp. </p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Jamison Hensley and Josh Weinfuss","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50381318"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50381318"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50381318"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50381318/sources-ravens-finalizing-trade-cardinals-qb-brissett"}},"premium":false}],"breakingNews":[],"timestamp":"2026-11-05T23:01:21Z","status":"success"}