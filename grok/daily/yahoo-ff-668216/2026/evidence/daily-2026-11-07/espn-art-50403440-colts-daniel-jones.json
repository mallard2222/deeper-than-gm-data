":"sportscenter://x-callback-url/showStory?uid=50381724"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50381724"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50381724/week-9-picks-predictions-schedule-fantasy-odds-2026"}},"premium":false}],"categories":[{"id":9572,"type":"league","uid":"s:20~l:28","guid":"ad4c3bd2-ddb6-3f8c-8abf-744855a08fa4","description":"NFL","sportId":28,"leagueId":28,"league":{"id":28,"description":"NFL","abbreviation":"NFL","links":{"mobile":{"leagues":{"href":"https://www.espn.com/nfl/"}},"web":{"leagues":{"href":"https://www.espn.com/nfl/"}}}}},{"id":2942,"type":"team","uid":"s:20~l:28~t:11","guid":"582d14eb-da61-e505-cc40-d972a1b60ed1","description":"Indianapolis Colts","sportId":28,"teamId":11,"team":{"id":11,"description":"Indianapolis Colts","abbreviation":"IND","shortDisplayName":"Colts","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ind/indianapolis-colts"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/ind/indianapolis-colts"}}}}},{"id":379778,"type":"athlete","uid":"s:20~l:28~a:3917792","guid":"5ad1bcc2-57bc-bb72-bcd0-0cdd0d945444","description":"Daniel Jones","sportId":28,"athleteId":3917792,"athlete":{"id":3917792,"description":"Daniel Jones","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3917792/daniel-jones"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3917792/daniel-jones"}}}}},{"id":409224,"type":"topic","guid":"52313677-19f8-b106-ec91-d8d17e6087fe","description":"news","sportId":0,"topicId":781},{"id":761447,"type":"contributor","guid":"53e92fd8-031a-34d6-9340-14d8a52d70fb","description":"Ian Rapoport","slug":"ian-rapoport","contributor":{"id":4396,"description":"Ian Rapoport","links":{"mobile":{"contributors":{"href":"https://www.espn.com/contributor/ian-rapoport"}},"web":{"contributors":{"href":"https://www.espn.com/contributor/ian-rapoport"}}}}},{"id":647276,"type":"contributor","guid":"9d87b78b-7e77-379a-93b0-fabb318139f1","description":"Adam Schefter","slug":"adam-schefter","contributor":{"id":1344,"description":"Adam Schefter","links":{"mobile":{"contributors":{"href":"https://www.espn.com/contributor/adam-schefter"}},"web":{"contributors":{"href":"https://www.espn.com/contributor/adam-schefter"}}}}}],"keywords":["NFL","Indianapolis Colts","Daniel Jones","news","Ian Rapoport","Adam Schefter"],"story":"<p>Not only have the <a data-clubhouse-guid=\"582d14eb-da61-e505-cc40-d972a1b60ed1\" href=\"https://www.espn.com/nfl/team/_/name/ind/indianapolis-colts\">Indianapolis Colts</a> engaged in trade discussions regarding running back <a data-player-guid=\"ddd8786c-fd5a-4e55-ccc8-6ddf6f1ede33\" href=\"https://www.espn.com/nfl/player/_/id/4242335/jonathan-taylor\">Jonathan Taylor</a>, they have also done the same regarding quarterback <a data-player-guid=\"5ad1bcc2-57bc-bb72-bcd0-0cdd0d945444\" href=\"https://www.espn.com/nfl/player/_/id/3917792/daniel-jones\">Daniel Jones</a>, league sources told NFL Network and ESPN.</p>\n<p>The Colts have received calls from multiple teams inquiring about trading for Jones, who is slated to start Sunday against the <a data-clubhouse-guid=\"b0fc8fb7-9dbe-e574-9008-6f0ee7c6b234\" href=\"https://www.espn.com/nfl/team/_/name/dal/dallas-cowboys\">Dallas Cowboys</a>, and Indianapolis has been willing to listen to any offers, according to league sources.</p>\n<p>The <a data-clubhouse-guid=\"38248455-3da4-84e4-8090-98b5cc38ffdc\" href=\"https://www.espn.com/nfl/team/_/name/bal/baltimore-ravens\">Baltimore Ravens</a> were one team to check in on Jones before they opted to trade for former <a data-clubhouse-guid=\"8fc7b962-95e1-3cb8-6a7d-b499de9ad546\" href=\"https://www.espn.com/nfl/team/_/name/ari/arizona-cardinals\">Arizona Cardinals</a> quarterback <a data-player-guid=\"efcb42e5-0bef-62d1-b58b-dbc17fde2479\" href=\"https://www.espn.com/nfl/player/_/id/2578570/jacoby-brissett\">Jacoby Brissett</a>. But the Ravens are hardly the only team to call the Colts about him, according to league sources.</p>\n<p><alsosee></p>\n<p>Speculation has also included the <a data-clubhouse-guid=\"3db556c9-ed76-a7a5-4ccb-a92fc6db4334\" href=\"https://www.espn.com/nfl/team/_/name/min/minnesota-vikings\">Minnesota Vikings</a>, a team Jones has history with and a team with a Super Bowl-caliber defense that shouldn't be ruled out.</p>\n<p>The Colts have preferred to wait until this week to ponder any potential trade for Jones, league sources said, if they even decide to move him at all.</p>\n<p>Similar to several players on their roster, Indianapolis is said to be open to having conversations about Jones. But the Colts are not interested in moving players unless they believe the offers are fair.</p>\n<p>Indianapolis is expected to take calls on Jones through Tuesday's 4 p.m. ET trade deadline because it is interested in acquiring as much draft capital as possible in addition to reducing financial risks.</p>\n<p>Jones has a $10.51 million injury guarantee for the 2027 season that becomes fully guaranteed March 15 should he remain on the Colts' roster. If the Colts (2-6) are eliminated from playoff contention, Indianapolis might not want to expose Jones to any injury and risk that $10.51 million guarantee, and a benching could come into play.</p>\n<p>It's also possible that if Jones wanted to play for another franchise, he could waive the injury guarantee on the $10.51 million, according to sources.</p>\n<p>Before his injury guarantee even becomes more of an issue than it already is, the Colts could opt to trade Jones, whom they signed to a two-year, $88 million contract that included a $44 million signing bonus in March.</p>\n<p>Jones received a vote of confidence this week from Colts coach Shane Steichen, who said that \"Daniel gives us the best chance to win right now.\" But Steichen's use of the phrase \"right now\" opened the door to what happens in the future -- and other teams have taken notice.</p>\n<p>With Jones potentially available, any team with a quarterback question or injury could call the Colts. It also is possible another team sustains a quarterback injury this weekend, as the Ravens did last weekend when they lost <a data-player-guid=\"7d76fbb1-1c5e-d9f4-954f-cad43f720ae2\" href=\"https://www.espn.com/nfl/player/_/id/3916387/lamar-jackson\">Lamar Jackson</a> and <a href=\"https://www.espn.com/nfl/player/_/id/4035671/tyler-huntley\">Tyler \"Snoop\" Huntley</a> to injuries that landed both quarterbacks on injured reserve.</p>\n\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":true,"allowSearch":true,"byline":"Ian Rapoport and Adam Schefter","isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50403440"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50403440"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50403440"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50403440/sources-colts-engaged-daniel-jones-trade-talks"}},"premium":false}],"breakingNews":[],"timestamp":"2026-11-07T22:58:34Z","status":"success"}