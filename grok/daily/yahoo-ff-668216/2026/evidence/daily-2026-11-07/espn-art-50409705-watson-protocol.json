":"CLE","shortDisplayName":"Browns","links":{"mobile":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/cle/cleveland-browns"}},"web":{"teams":{"href":"https://www.espn.com/nfl/team/_/name/cle/cleveland-browns"}}}}},{"id":409224,"type":"topic","guid":"52313677-19f8-b106-ec91-d8d17e6087fe","description":"news","sportId":0,"topicId":781},{"id":166843,"type":"athlete","uid":"s:20~l:28~a:3122840","guid":"b6ec8e9e-3d85-a1de-9d0a-5a51621a9c20","description":"Deshaun Watson","sportId":28,"athleteId":3122840,"athlete":{"id":3122840,"description":"Deshaun Watson","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3122840/deshaun-watson"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/3122840/deshaun-watson"}}}}},{"id":466378,"type":"athlete","uid":"s:20~l:28~a:4432762","guid":"fecbc03c-f8bf-342e-82be-991901cf6449","description":"Shedeur Sanders","sportId":28,"athleteId":4432762,"athlete":{"id":4432762,"description":"Shedeur Sanders","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4432762/shedeur-sanders"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4432762/shedeur-sanders"}}}}},{"id":390472,"type":"athlete","uid":"s:20~l:28~a:4427238","guid":"2126efde-bc9b-0168-dd5a-49fe11331807","description":"Dillon Gabriel","sportId":28,"athleteId":4427238,"athlete":{"id":4427238,"description":"Dillon Gabriel","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4427238/dillon-gabriel"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4427238/dillon-gabriel"}}}}},{"id":489609,"type":"athlete","uid":"s:20~l:28~a:4431325","guid":"cf3a4802-6118-33d2-a980-d4e6076522b2","description":"Taylen Green","sportId":28,"athleteId":4431325,"athlete":{"id":4431325,"description":"Taylen Green","links":{"mobile":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4431325/taylen-green"}},"web":{"athletes":{"href":"https://www.espn.com/nfl/player/_/id/4431325/taylen-green"}}}}}],"keywords":["NFL","Cleveland Browns","news","Deshaun Watson","Shedeur Sanders","Dillon Gabriel","Taylen Green"],"story":"<p><a data-clubhouse-guid=\"539babc5-e5fb-753b-8ae1-c15032a91ef4\" href=\"https://www.espn.com/nfl/team/_/name/cle/cleveland-browns\">Cleveland Browns</a> quarterback <a data-player-guid=\"b6ec8e9e-3d85-a1de-9d0a-5a51621a9c20\" href=\"https://www.espn.com/nfl/player/_/id/3122840/deshaun-watson\">Deshaun Watson</a> has cleared concussion protocol, but he remains questionable for Sunday's game against the <a data-clubhouse-guid=\"97d2f6c9-2f22-459c-306a-046941ccab2a\" href=\"https://www.espn.com/nfl/team/_/name/no/new-orleans-saints\">New Orleans Saints</a>.</p>\n<p>Browns coach Todd Monken said Friday that <a data-player-guid=\"fecbc03c-f8bf-342e-82be-991901cf6449\" href=\"https://www.espn.com/nfl/player/_/id/4432762/shedeur-sanders\">Shedeur Sanders</a> will get the start. It's unclear if Watson will serve as the backup or if that responsibility will fall to <a data-player-guid=\"2126efde-bc9b-0168-dd5a-49fe11331807\" href=\"https://www.espn.com/nfl/player/_/id/4427238/dillon-gabriel\">Dillon Gabriel</a> or <a data-player-guid=\"cf3a4802-6118-33d2-a980-d4e6076522b2\" href=\"https://www.espn.com/nfl/player/_/id/4431325/taylen-green\">Taylen Green</a>.</p>\n<p>Sanders has attempted just three passes this season in spot appearances during two games. He took all the starting reps in practice this week after Watson self-reported concussion symptoms Tuesday morning and was placed in the protocol.</p>\n<p><alsosee></p>\n<p>As a rookie last season, Sanders made seven starts, completing 56.6% of his passes for 1,400 yards with seven touchdowns and 10 interceptions. He went 3-4 in those starts.</p>\n<p>Cleveland (5-3) faces the Saints this week and then hosts the <a data-clubhouse-guid=\"595690b3-2161-4913-a7a7-814af2fd2621\" href=\"https://www.espn.com/nfl/team/_/name/hou/houston-texans\">Houston Texans</a> in Week 10 before entering their bye.</p>\n<p><i>Information from ESPN's Daniel Oyefusi was used in this report.</i></p>\n\n\n\n","allowAMP":true,"allowAds":true,"allowComments":true,"allowCommerce":true,"allowContentReactions":false,"allowSearch":true,"isLiveBlog":false,"links":{"api":{"self":{"href":"https://content.core.api.espn.com/v1/sports/news/50409705"}},"app":{"sportscenter":{"href":"sportscenter://x-callback-url/showStory?uid=50409705"}},"mobile":{"href":"http://m.espn.go.com/nfl/story?storyId=50409705"},"web":{"href":"https://www.espn.com/nfl/story/_/id/50409705/browns-qb-deshaun-watson-concussion-protocol"}},"premium":false}],"breakingNews":[],"timestamp":"2026-11-07T22:58:33Z","status":"success"}