{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mallard2222/deeper-than-gm-data/blob/main/grok/intel/yahoo-ff-668216/2026/schema/run-metadata.schema.json",
  "title": "Deeper Than intelligence run metadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "routine_folder": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "minLength": 1 },
    "nfl_week": { "type": "integer", "minimum": 1, "maximum": 23 },
    "coverage": { "type": "object" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "last_successful_source_refresh": { "type": ["string", "null"], "format": "date-time" },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commit_sha": { "type": ["string", "null"] },
    "delivery_status": { "type": "string", "enum": ["pending", "delivered", "failed"] }
  },
  "required": [
    "run_id",
    "routine_folder",
    "started_at",
    "finished_at",
    "timezone",
    "nfl_week",
    "coverage",
    "errors",
    "last_successful_source_refresh",
    "files_changed",
    "commit_sha",
    "delivery_status"
  ]
}
